{
  "defaultProvider": "ollama",
  "defaultModel": "gemma4:12b-mlx",
  "enabledModels": ["ollama/gemma4:12b-mlx", "ollama/qwen3.5:9b-mlx"],
  "defaultThinkingLevel": "high",

  "defaultTools": [
